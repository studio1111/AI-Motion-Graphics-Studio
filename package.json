{
  "name": "ai-motion-graphics-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Data-driven Remotion production engine for autonomous motion-graphics storyboards, rendering, and quality checks.",
  "scripts": {
    "validate:skills": "node scripts/validate-skills.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run validate:skills && npm test",
    "render:demo": "remotion render src/index.ts MotionDemo out/motion-demo.mp4 --codec=h264",
    "render:smoke": "remotion render src/index.ts MotionVideo out/motion-video-smoke.mp4 --props=fixtures/smoke-props.json --codec=h264",
    "produce": "node scripts/produce.mjs",
    "research:catalog": "node scripts/reference-catalog.mjs",
    "prompts:list": "node scripts/prompt-library.mjs list",
    "prompts:search": "node scripts/prompt-library.mjs search",
    "prompts:show": "node scripts/prompt-library.mjs show",
    "prompts:master": "node scripts/prompt-library.mjs master",
    "prompts:export": "node scripts/prompt-library.mjs export"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
